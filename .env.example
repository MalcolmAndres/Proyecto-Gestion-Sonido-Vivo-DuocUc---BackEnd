# Copia este archivo como .env (el .env NO se sube a git).
DB_PASSWORD=cambia-esta-clave
# Clave del JWT en Base64 (32 bytes o más). La MISMA en todos los microservicios y en ms-auth.
# Generarla en PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=pega-aqui-la-clave-generada
